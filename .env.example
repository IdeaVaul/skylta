# Kopiera till .env.local och fyll i. Lägg ALDRIG riktiga nycklar i git.

# Adressen där appen körs (din domän i produktion)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase – Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: bara på servern, får aldrig börja med NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Stripe – valfritt. Utan STRIPE_SECRET_KEY startas testperioden utan kort i appen.
# Börja i testläge (sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_PROFFS=
STRIPE_PRICE_BYRA=

# Google Places API (New) – för att hitta företag
GOOGLE_PLACES_API_KEY=

# AI – för att tolka beställningar och skriva sajter.
# På Vercel behövs ingen nyckel: appen använder Vercel AI Gateway med projektets egen token.
# Sätt ANTHROPIC_API_KEY bara om du vill gå direkt mot Anthropic (krävs lokalt).
# ANTHROPIC_API_KEY=
# AI_MODEL=anthropic/claude-haiku-5.5

# Databasadress för automatiska migreringar vid bygget (sätts av Supabase-kopplingen på Vercel)
# POSTGRES_URL_NON_POOLING=
# Ditt eget konto får planen Start vid varje publicering
# SKYLTA_OWNER_EMAIL=
