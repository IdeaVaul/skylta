# Kopiera till .env.local och fyll i. Lägg ALDRIG riktiga nycklar i git.

# Adressen där appen körs (din domän i produktion)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase – Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: bara på servern, får aldrig börja med NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Stripe – börja i testläge (sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_PROFFS=
STRIPE_PRICE_BYRA=

# Google Places API (New) – för att hitta företag
GOOGLE_PLACES_API_KEY=

# Anthropic – för att tolka beställningar och skriva sajter
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
